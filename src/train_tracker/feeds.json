{
  "_comment": "Feed definitions. ${NAME} is replaced from the environment or .env; a feed whose key is missing is skipped. url: vehicle positions; trip_updates_url / alerts_url: separate predictions and alerts feeds (otherwise they're read from url when it carries them); static: the railroad's schedule zip (inner: a zip inside it); route_prefix / route_ids: the rail routes in feeds shared with buses or subways. Speeds in GTFS-RT are m/s. train_labels: false when the vehicle label isn't a train number.",
  "stale_after_s": 600,
  "feeds": [
    {
      "id": "amtrak",
      "agency": "Amtrak",
      "kind": "gtfsrt",
      "mode": "intercity",
      "url": "https://asm-backend.transitdocs.com/gtfs/amtrak",
      "interval_s": 20,
      "static": {
        "url": "https://content.amtrak.com/content/gtfs/GTFS.zip"
      },
      "credit": "Amtrak positions via Transitdocs"
    },
    {
      "id": "amtraker",
      "agency": "Amtrak",
      "kind": "amtraker",
      "mode": "intercity",
      "url": "https://api-v3.amtraker.com/v3/trains",
      "interval_s": 60,
      "fallback_for": "amtrak",
      "credit": "Amtraker API (ODC-By 1.0), https://amtraker.com"
    },
    {
      "id": "mbta",
      "agency": "MBTA Commuter Rail",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://cdn.mbta.com/realtime/VehiclePositions.pb",
      "route_prefix": "CR-",
      "interval_s": 30,
      "credit": "MBTA",
      "trip_updates_url": "https://cdn.mbta.com/realtime/TripUpdates.pb",
      "alerts_url": "https://cdn.mbta.com/realtime/Alerts.pb",
      "static": {
        "url": "https://cdn.mbta.com/MBTA_GTFS.zip"
      }
    },
    {
      "id": "lirr",
      "agency": "LIRR",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/lirr%2Fgtfs-lirr",
      "interval_s": 20,
      "credit": "MTA",
      "alerts_url": "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Flirr-alerts",
      "static": {
        "url": "https://rrgtfsfeeds.s3.amazonaws.com/gtfslirr.zip"
      }
    },
    {
      "id": "mnr",
      "agency": "Metro-North",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/mnr%2Fgtfs-mnr",
      "interval_s": 20,
      "credit": "MTA",
      "alerts_url": "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fmnr-alerts",
      "static": {
        "url": "https://rrgtfsfeeds.s3.amazonaws.com/gtfsmnr.zip"
      }
    },
    {
      "id": "septa",
      "agency": "SEPTA Regional Rail",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://www3.septa.org/gtfsrt/septarail-pa-us/Vehicle/rtVehiclePosition.pb",
      "interval_s": 30,
      "credit": "SEPTA",
      "trip_updates_url": "https://www3.septa.org/gtfsrt/septarail-pa-us/Trip/rtTripUpdates.pb",
      "alerts_url": "https://www3.septa.org/gtfsrt/septarail-pa-us/Service/rtServiceAlerts.pb",
      "static": {
        "url": "https://www3.septa.org/developer/gtfs_public.zip",
        "inner": "google_rail.zip"
      }
    },
    {
      "id": "metra",
      "agency": "Metra",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://gtfspublic.metrarr.com/gtfs/public/positions",
      "params": {
        "api_token": "${METRA_API_TOKEN}"
      },
      "headers": {
        "Authorization": "Bearer ${METRA_API_TOKEN}"
      },
      "interval_s": 30,
      "credit": "Metra",
      "signup": "https://metra.com/developers",
      "signup_help": "Accept Metra's licence agreement and fill in the short form; Metra emails you an API token.",
      "key_labels": {
        "METRA_API_TOKEN": "API token"
      },
      "trip_updates_url": "https://gtfspublic.metrarr.com/gtfs/public/tripupdates",
      "alerts_url": "https://gtfspublic.metrarr.com/gtfs/public/alerts"
    },
    {
      "id": "caltrain",
      "agency": "Caltrain",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://api.511.org/transit/vehiclepositions",
      "params": {
        "api_key": "${API_511_KEY}",
        "agency": "CT"
      },
      "interval_s": 60,
      "credit": "511.org",
      "signup": "https://511.org/open-data/token",
      "signup_help": "Caltrain's live data comes through 511 SF Bay. Enter your email on the token page and 511 emails you a key.",
      "key_labels": {
        "API_511_KEY": "511 API key"
      },
      "trip_updates_url": "https://api.511.org/transit/tripupdates",
      "alerts_url": "https://api.511.org/transit/servicealerts",
      "static": {
        "url": "https://data.trilliumtransit.com/gtfs/caltrain-ca-us/caltrain-ca-us.zip"
      }
    },
    {
      "id": "metrolink",
      "agency": "Metrolink",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://metrolink-gtfsrt.gbsdigital.us/feed/gtfsrt-vehicles",
      "headers": {
        "x-api-key": "${METROLINK_API_KEY}"
      },
      "interval_s": 30,
      "credit": "Metrolink",
      "signup": "https://metrolinktrains.com/about/gtfs/gtfs-rt-access/",
      "signup_help": "Enter your email on Metrolink's GTFS-RT access page and the key is emailed to you.",
      "key_labels": {
        "METROLINK_API_KEY": "API key"
      },
      "trip_updates_url": "https://metrolink-gtfsrt.gbsdigital.us/feed/gtfsrt-trips",
      "alerts_url": "https://metrolink-gtfsrt.gbsdigital.us/feed/gtfsrt-alerts",
      "static": {
        "url": "https://metrolinktrains.com/globalassets/about/gtfs/gtfs.zip"
      }
    },
    {
      "id": "marc",
      "agency": "MARC",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://mdotmta-gtfs-rt.s3.amazonaws.com/MARC+RT/marc-vp.pb",
      "trip_updates_url": "https://mdotmta-gtfs-rt.s3.amazonaws.com/MARC+RT/marc-tu.pb",
      "static": {
        "url": "https://mdotmta-gtfs.s3.amazonaws.com/mdotmta_gtfs_marc.zip"
      },
      "interval_s": 30,
      "credit": "Maryland Transit Administration"
    },
    {
      "id": "vre",
      "agency": "VRE",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://gtfs.vre.org/containercdngtfsupload/VehiclePositionFeed",
      "trip_updates_url": "https://gtfs.vre.org/containercdngtfsupload/TripUpdateFeed",
      "alerts_url": "https://gtfs.vre.org/containercdngtfsupload/AlertFeed",
      "static": {
        "url": "https://gtfs.vre.org/containercdngtfsupload/google_transit.zip"
      },
      "interval_s": 30,
      "credit": "Virginia Railway Express"
    },
    {
      "id": "rtd",
      "agency": "RTD Commuter Rail",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://www.rtd-denver.com/api/download?feedType=gtfs-rt&filename=VehiclePosition.pb",
      "trip_updates_url": "https://www.rtd-denver.com/api/download?feedType=gtfs-rt&filename=TripUpdate.pb",
      "alerts_url": "https://www.rtd-denver.com/api/download?feedType=gtfs-rt&filename=Alerts.pb",
      "route_ids": [
        "A",
        "113B",
        "113G",
        "117N"
      ],
      "static": {
        "url": "https://www.rtd-denver.com/api/download?feedType=gtfs&filename=google_transit.zip"
      },
      "interval_s": 30,
      "credit": "RTD Denver",
      "train_labels": false
    },
    {
      "id": "capmetro",
      "agency": "CapMetro Rail",
      "kind": "gtfsrt",
      "mode": "commuter",
      "url": "https://data.texas.gov/download/eiei-9rpf/application%2Foctet-stream",
      "trip_updates_url": "https://data.texas.gov/download/rmk2-acnw/application%2Foctet-stream",
      "route_ids": [
        "550"
      ],
      "static": {
        "url": "https://data.texas.gov/download/r4v4-vz24/application%2Fzip"
      },
      "interval_s": 30,
      "credit": "Capital Metro (Austin)"
    },
    {
      "id": "njt",
      "agency": "NJ Transit Rail",
      "kind": "njt",
      "mode": "commuter",
      "url": "https://raildata.njtransit.com/api/GTFSRT",
      "username": "${NJT_USERNAME}",
      "password": "${NJT_PASSWORD}",
      "interval_s": 30,
      "credit": "NJ Transit",
      "signup": "https://developer.njtransit.com/registration/",
      "signup_help": "Register for a RailData developer account. NJ Transit uses the account's username and password, not a single key.",
      "key_labels": {
        "NJT_USERNAME": "Username",
        "NJT_PASSWORD": "Password"
      }
    }
  ]
}
