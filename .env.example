# Copy to ~/.train-tracker/.env (or .env in the folder you start train-tracker from) and fill in the keys
# you have; feeds without a key stay switched off. Restart train-tracker after editing. Keys are free.

# Metra (Chicago): agree to the licence and fill in the form at https://metra.com/developers
METRA_API_TOKEN=

# Caltrain, via 511 SF Bay: enter your email at https://511.org/open-data/token
API_511_KEY=

# Metrolink (Los Angeles): enter your email at https://metrolinktrains.com/about/gtfs/gtfs-rt-access/
METROLINK_API_KEY=

# NJ Transit: register for RailData at https://developer.njtransit.com/registration/
# (use the username and password of that developer account)
NJT_USERNAME=
NJT_PASSWORD=
