# Copy to .env and fill in the keys you have; feeds without a key stay disabled.
# Metra: https://metra.com/developers
METRA_API_TOKEN=
# Caltrain via 511 SF Bay: https://511.org/open-data/token
API_511_KEY=
# Metrolink: https://metrolinktrains.com/about/agency/developer-resources/
METROLINK_API_KEY=
# NJ Transit RailData: https://developer.njtransit.com/registration/login
NJT_USERNAME=
NJT_PASSWORD=
